# OpenMontage - Environment Variables
# Copy this to .env and fill in your keys

# --- Application infrastructure ---
ENVIRONMENT=development
# Required. Use a dedicated OpenMontage PostgreSQL database; inject credentials from a secret store.
DATABASE_URL=
# Use a dedicated Redis database number and the OpenMontage key prefix.
REDIS_URL=redis://127.0.0.1:6379/4
REDIS_PREFIX=openmontage:
PUBLIC_ORIGIN=http://127.0.0.1:5173
SESSION_COOKIE_NAME=om_session
SESSION_COOKIE_SECURE=true
SESSION_IDLE_SECONDS=604800
SESSION_ABSOLUTE_SECONDS=2592000
# Required secret; use at least 32 cryptographically random characters.
AUTH_HMAC_SECRET=

# --- Transactional email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
# Required transport security mode: starttls or ssl. Plaintext SMTP is not supported.
SMTP_TLS_MODE=starttls

# --- EPay Alipay recharge ---
# Optional. Configure all three values together; keep EPAY_KEY in a secret store.
# EPAY_PAY_ADDRESS is the EPay base URL; /submit.php is appended like NewAPI.
# EPAY_ID is the merchant/partner id.
# Public callbacks are derived from PUBLIC_ORIGIN:
#   ${PUBLIC_ORIGIN}/api/payments/epay/notify
#   ${PUBLIC_ORIGIN}/api/payments/epay/return
EPAY_PAY_ADDRESS=
EPAY_ID=
EPAY_KEY=

# --- NewAPI provider billing ---
# Keep token keys in a secret store. Aliases are stable, non-secret rotation IDs.
# Retain old aliases until all jobs and reconciliations that reference them are terminal.
NEWAPI_BASE_URL=http://127.0.0.1:3000
# Example: NEWAPI_TEXT_TOKEN_KEYS_JSON={"text-v1":"<set-in-secret-store>"}
NEWAPI_TEXT_TOKEN_KEYS_JSON=
# Example: NEWAPI_TEXT_CURRENT_TOKEN_ALIAS=text-v1
NEWAPI_TEXT_CURRENT_TOKEN_ALIAS=
# Example: NEWAPI_IMAGE_TOKEN_KEYS_JSON={"image-v1":"<set-in-secret-store>"}
NEWAPI_IMAGE_TOKEN_KEYS_JSON=
# Example: NEWAPI_IMAGE_CURRENT_TOKEN_ALIAS=image-v1
NEWAPI_IMAGE_CURRENT_TOKEN_ALIAS=
# Example: NEWAPI_VIDEO_TOKEN_KEYS_JSON={"video-v1":"<set-in-secret-store>"}
NEWAPI_VIDEO_TOKEN_KEYS_JSON=
# Example: NEWAPI_VIDEO_CURRENT_TOKEN_ALIAS=video-v1
NEWAPI_VIDEO_CURRENT_TOKEN_ALIAS=
BILLING_REFERENCE_RECOVERY_SECONDS=86400
BILLING_RECEIPT_DEADLINE_SECONDS=86400
BILLING_HOLD_TIMEOUT_SECONDS=86400
BILLING_QUOTE_STALE_RETRIES=2
BILLING_MAX_VIDEO_BYTES=536870912
BILLING_DEFAULT_MULTIPLIER_BPS=15000
# Run exactly one supervised reconciliation worker per environment:
#   python -m server.billing_worker
# One-shot operator recovery:
#   python -m server.manage reconcile-billing --once

# --- Image + video gateway ---
FAL_KEY=                     # FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images
                             # Get one at https://fal.ai/dashboard/keys

# --- Google (one key unlocks image gen + TTS) ---
GOOGLE_API_KEY=              # Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages)
                             # Get one at https://aistudio.google.com/apikey
# Alternative to the API key: service-account JSON auth.
# TTS uses Cloud Text-to-Speech; Imagen routes to Vertex AI.
GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account JSON key file
GOOGLE_CLOUD_PROJECT=             # GCP project id (required for Imagen via Vertex AI)
GOOGLE_CLOUD_LOCATION=            # Vertex AI region, default us-central1

# --- Voice ---
ELEVENLABS_API_KEY=          # TTS narration, music generation, sound effects
OPENAI_API_KEY=              # OpenAI TTS fallback and DALL-E image generation
XAI_API_KEY=                 # Grok image generation/editing and Grok video generation
DOUBAO_SPEECH_API_KEY=       # Volcengine Doubao Speech TTS (new console API Key)
DOUBAO_SPEECH_VOICE_TYPE=    # Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts
# Piper local voices do not require env vars; install `piper-tts` via pip

# --- Music ---
SUNO_API_KEY=                # Suno AI music generation (full songs, instrumentals, any genre)

# --- Video Generation ---
HEYGEN_API_KEY=              # HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key)
RUNWAY_API_KEY=              # Runway Gen-4 (direct API, alternative to fal.ai routing)
VIDEO_GEN_LOCAL_ENABLED=     # Set to "true" for local video gen (needs GPU + diffusers)
VIDEO_GEN_LOCAL_MODEL=       # Local model: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b
MODAL_LTX2_ENDPOINT_URL=    # Modal self-hosted LTX-2 endpoint (optional)

# --- Stock Media ---
PEXELS_API_KEY=              # Pexels stock footage/images (free)
PIXABAY_API_KEY=             # Pixabay stock footage/images (free)
UNSPLASH_ACCESS_KEY=         # Unsplash stock images (free developer key)

# --- Analysis ---
HF_TOKEN=                    # HuggingFace token — enables speaker diarization in transcriber

# --- Avatar (local installs) ---
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)
